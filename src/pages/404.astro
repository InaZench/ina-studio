---
// Страница «не найдено» в стиле сайта (GitHub Pages показывает её по любому неверному адресу)
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — INA" description="This page does not exist. INA Studio — cinematic AI advertising films for brands.">
  <section class="bg-[#EFEAE0] px-6 md:px-10 min-h-[100svh] flex flex-col items-center justify-center text-center pt-[120px] pb-24">
    <p data-reveal class="text-[10px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase mb-10">
      Error 404
    </p>
    <h1 data-reveal style="--d: 120ms" class="font-serif italic font-light text-[30px] md:text-[44px] leading-tight text-[#8B6F47] mb-12">
      This page has drifted off.
    </h1>
    <a
      data-reveal
      style="--d: 260ms"
      href="/"
      class="group inline-flex items-center gap-4 font-serif font-light text-[22px] md:text-[26px] text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700"
    >
      <span>Back to the work</span>
      <svg class="w-[0.85em] h-[0.5em] translate-y-[0.06em] shrink-0 transition-[translate] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:translate-x-[6px]" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 10h32M24 2l8 8-8 8"/></svg>
    </a>
  </section>
</Layout>
