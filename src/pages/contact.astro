---
import Layout from "../layouts/Layout.astro";

---

<Layout title="Contact — INA">
  <!-- HERO INVITATION -->
  <section class="bg-[#0A0A0A] min-h-screen px-6 md:px-10 flex flex-col items-center justify-center text-center">
    <p class="text-[10px] font-light tracking-[0.3em] text-[#FAFAF7]/50 uppercase mb-10">
      Contact
    </p>
    <h1 class="font-serif font-light text-[36px] md:text-[72px] text-[#FAFAF7] leading-[1.15] max-w-[900px] mb-14">
      Let's create something together.
    </h1>
    <a
      href="mailto:ina.studio.creative@gmail.com"
      class="font-serif font-light text-[22px] md:text-[38px] text-[#FAFAF7] underline underline-offset-[6px] decoration-[0.5px] mb-6 hover:text-[#8B6F47] transition-colors duration-700"
    >
      ina.studio.creative@gmail.com
    </a>
    <p data-copy-hint="Click to copy" class="text-[11px] font-light tracking-[0.2em] text-[#FAFAF7]/50 uppercase">
      Click to copy
    </p>
  </section>

</Layout>
