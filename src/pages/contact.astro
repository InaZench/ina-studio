---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — INA">
  <!-- INVITATION (светлый верх, как на остальных страницах) -->
  <section class="bg-[#EFEAE0] px-6 md:px-10 pt-44 md:pt-56 pb-24 md:pb-32 text-center">
    <p class="text-[10px] font-light tracking-[0.3em] text-[#999999] uppercase mb-9">
      Contact
    </p>
    <h1 class="font-serif font-light text-[36px] md:text-[64px] text-[#0A0A0A] leading-[1.15] max-w-[900px] mx-auto" style="text-wrap: balance;">
      Let's create something together.
    </h1>
  </section>

  <!-- EMAIL (тёмный блок, как внизу остальных страниц) -->
  <section class="bg-[#0A0A0A] px-6 md:px-10 py-28 md:py-32 min-h-[480px] flex flex-col items-center justify-center text-center">
    <a
      href="mailto:ina.studio.creative@gmail.com"
      class="font-serif font-light text-[22px] md:text-[42px] text-[#FAFAF7] underline underline-offset-[8px] decoration-[0.5px] mb-6 hover:text-[#8B6F47] transition-colors duration-700"
    >
      ina.studio.creative@gmail.com
    </a>
    <p data-copy-hint="Click to copy" class="text-[11px] font-light tracking-[0.2em] text-[#FAFAF7]/50 uppercase">
      Click to copy
    </p>
  </section>
</Layout>
