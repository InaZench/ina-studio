---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";


const cmsEntries = await getCollection("projects");
const cmsWork = cmsEntries.map((entry) => ({
  title: entry.data.title,
  client: `${entry.data.eyebrow} — ${entry.data.year}`,
  slug: entry.id,
  coverImage: entry.data.coverImage,
}));

const selectedWork = cmsWork.slice(0, 4);
---

<Layout title="INA — Visual stories for brands">
<section class="relative w-screen h-screen overflow-hidden bg-[#0E0E0E]">
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover opacity-75" style="z-index:0;" preload="auto"
    poster="/hero-poster.jpg"
  >
    <source src="/0607.mp4" type="video/mp4" />
  </video>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#000000]"></div>

    <div class="relative z-10 flex flex-col justify-end h-full px-6 md:px-10 pb-16 md:pb-20 text-white">
      <p class="text-[10px] md:text-[11px] font-light tracking-[0.3em] uppercase text-white/60 mb-5">
        Showreel · 2026
      </p>
      <h1 class="font-serif font-light leading-[1.05] text-[42px] md:text-[88px] max-w-4xl">
        Visual stories<br />for brands.
      </h1>
      <p class="font-serif text-[18px] md:text-[24px] font-light text-white/70 mt-6 max-w-xl">
        Cinematic content crafted with AI.
      </p>
    </div>

    <div class="absolute bottom-6 right-6 md:bottom-8 md:right-10 text-[10px] font-light tracking-[0.3em] uppercase text-white/50">
      Scroll ↓
    </div>
  </section>

  <section class="bg-[#EFEAE0] px-6 md:px-10 pt-32 md:pt-44 pb-32 md:pb-44">
    <div class="max-w-[1280px] mx-auto">
      <p class="text-[10px] font-light tracking-[0.3em] pl-[0.3em] text-[#8C8579] uppercase text-center mb-10">
        Selected Work
      </p>
      <h2 class="font-serif italic font-light text-[30px] md:text-[44px] text-[#8B6F47] text-center mb-20 md:mb-28">
        A selection of recent projects.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
        {selectedWork.map((project, i) => (
          <a
            href={`/work/${project.slug}`}
            class={`group block ${i % 2 === 1 ? "md:mt-32" : ""}`}
          >
            <div
              class={`bg-[#1A1A1A] overflow-hidden mb-6 transition-transform duration-700 group-hover:scale-[1.02] ${
                i % 2 === 0 ? "aspect-[16/10]" : "aspect-[3/4]"
              }`}
              style={project.coverImage ? `background-image: url('${project.coverImage}'); background-size: cover; background-position: center;` : ""}
            ></div>
            <h3 class="font-serif text-[24px] md:text-[26px] font-normal text-[#8B6F47] leading-tight group-hover:text-[#6E5636] transition-colors duration-700">
              {project.title}
            </h3>
            <p class="mt-2 text-[11px] font-light tracking-[0.05em] text-[#8C8579] uppercase">
              {project.client}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#E9E3D7] px-6 md:px-10 pt-20 pb-0 md:pt-24 md:pb-0">
    <div class="max-w-[880px] mx-auto text-center">
      <p class="text-[10px] font-light tracking-[0.3em] pl-[0.3em] text-[#8C8579] uppercase mb-10">
        <!-- оптическая разрядка: круглые O, A, C в Inter стоят плотнее остальных букв -->
        App<span style="letter-spacing: 3.4px">r</span><span style="letter-spacing: 4px">o</span><span style="letter-spacing: 4px">a</span>ch
      </p>
      <h2 class="font-serif font-light text-[30px] md:text-[44px] text-[#8B6F47] leading-tight mb-12">
        Cinematic content,<br />crafted with AI.
      </h2>
      <p class="font-sans text-[15px] md:text-[16px] font-light text-[#8C8579] leading-relaxed max-w-[560px] mx-auto">
        Cinematic advertising for brands. Every frame goes through a deliberate process: concept, AI generation, editing, colour, sound.
      </p>
    </div>
  </section>

  <section class="bg-[#E9E3D7] px-6 md:px-10 pt-[83px] pb-20 md:pt-[86px] md:pb-24 flex flex-col items-center justify-center">
    <!-- короткая линия-разделитель между Approach и почтой (один фон) -->
    <span class="block w-12 h-px bg-[#8B6F47]/40 mb-[77px] md:mb-[74px]" aria-hidden="true"></span>
    <!-- почта — один в один как на страницах кейсов (CaseStacked) -->
    <a
      href="mailto:ina.studio.creative@gmail.com"
      class="font-serif font-light text-[26px] md:text-[46px] text-[#8B6F47] underline underline-offset-[10px] md:underline-offset-[11px] decoration-[0.5px] mb-7 md:mb-8 hover:text-[#6E5636] transition-colors duration-700"
    >
      ina.studio.creative@gmail.com
    </a>
    <p class="text-[11px] font-light tracking-[0.2em] pl-[0.2em] text-[#8C8579] uppercase">
      Click to write
    </p>
  </section>
</Layout>
