---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";


const cmsEntries = await getCollection("projects");
const cmsWork = cmsEntries.map((entry) => ({
  title: entry.data.title,
  client: `${entry.data.eyebrow} — ${entry.data.year}`,
  slug: entry.id,
  coverImage: entry.data.coverImage,
}));

const selectedWork = cmsWork.slice(0, 4);
---

<Layout title="INA — Visual stories for brands">
<!-- 22.11.2026 (по просьбе): на телефоне — тот же приём, что на компьютере: текст поверх ролика внизу, на затемнении;
     ролик сразу под шапкой (55 px), кадр 4:3 (почти весь кадр 16:9 виден, ролик крупнее), надписи в пропорциях компьютера: мелкая подпись и нижняя строка заметно меньше заголовка (7 / 26 / 9 px — 22.11.2026: доля экрана как на компьютере: заголовок ≈ 6.5 % ширины).
     Компьютер без изменений: во весь экран. -->
<!-- 22.11.2026: на компьютере ролик под шапкой (67 px) и целиком 16:9 — без обрезки сверху/снизу на широких экранах -->
<!-- 28.11.2026 (по просьбе, вариант Б): вместо шоурила — промо INA во всю яркость, без затемнения; из надписей только «Scroll ↓» на ролике.
     Телефон: вертикальная версия промо 9:16 целиком (без обрезки краёв); компьютер: 16:9 целиком. Прежний шоурил: /0607.mp4, /hero-poster.jpg. -->
<section class="relative w-full overflow-hidden bg-[#0E0E0E] pt-[55px] md:pt-[67px]">
  <div class="hero-frame relative w-full aspect-[9/16] md:aspect-video">
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover" style="z-index:0;" preload="auto"
    poster="/hero-ina-promo-poster.jpg"
  >
    <source src="/hero-ina-promo-9x16.mp4" type="video/mp4" media="(max-width: 767px)" />
    <source src="/hero-ina-promo.mp4" type="video/mp4" />
  </video>
    <div data-reveal style="--d: 1000ms" class="absolute bottom-5 right-6 md:bottom-auto md:top-[calc(min(100%,100svh-67px)-3.25rem)] md:right-10 -mr-[0.3em] z-10 text-[8px] md:text-[10px] font-light tracking-[0.3em] uppercase text-white/80 mix-blend-difference">
      Scroll ↓
    </div>
  </div>

  <!-- 28.11.2026 (по просьбе): основные надписи убраны, на ролике только «Scroll ↓» справа внизу; заголовок оставлен для поисковиков и экранных дикторов (невидим) -->
  <h1 class="sr-only">Visual stories for brands.</h1>
</section>

  <!-- 22.11.2026: на телефоне блок проектов ближе к шоурилу (отступ 128 → 56 px, под заголовком 80 → 48 px) -->
  <section class="bg-[#EFEAE0] px-6 md:px-10 pt-14 md:pt-44 pb-20 md:pb-28">
    <div class="max-w-[1280px] mx-auto">
      <p data-reveal class="text-[10px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase text-center mb-10">
        Selected Work
      </p>
      <h2 data-reveal style="--d: 120ms" class="font-serif italic font-light text-[30px] md:text-[44px] text-[#8B6F47] text-center mb-12 md:mb-28">
        A selection of recent projects.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
        {selectedWork.map((project, i) => (
          <a
            data-reveal
            style={`--d: ${(i % 2) * 180}ms`}
            href={`/${project.slug}/`}
            class={`group block ${i % 2 === 1 ? "md:mt-32" : ""}`}
          >
            <!-- рамка неподвижна, при наведении картинка медленно приближается внутри неё -->
            <div
              class={`relative bg-[#1A1A1A] overflow-hidden mb-6 ${
                i % 2 === 0 ? "aspect-[16/10]" : "aspect-[1/1] md:aspect-[3/4]"
              }`}
            >
              <div
                class="absolute inset-0 transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:scale-[1.045]"
                style={project.coverImage ? `background-image: url('${project.coverImage}'); background-size: cover; background-position: center;` : ""}
              ></div>
            </div>
            <h3 class="font-serif text-[24px] md:text-[26px] font-normal text-[#8B6F47] leading-tight group-hover:text-[#6E5636] transition-colors duration-700">
              {project.title}
            </h3>
            <p class="mt-2 text-[11px] font-light tracking-[0.05em] text-[#6B6458] uppercase">
              {project.client}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 23.11.2026: блок Approach → почта подтянут (меньше пустых отступов) -->
  <section class="bg-[#E9E3D7] px-6 md:px-10 pt-16 pb-0 md:pt-20 md:pb-0">
    <div class="max-w-[880px] mx-auto text-center">
      <p data-reveal class="text-[10px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase mb-10">
        <!-- оптическая разрядка: круглые O, A, C в Inter стоят плотнее остальных букв -->
        App<span style="letter-spacing: 3.4px">r</span><span style="letter-spacing: 4px">o</span><span style="letter-spacing: 4px">a</span>ch
      </p>
      <h2 data-reveal style="--d: 120ms" class="font-serif font-light text-[30px] md:text-[44px] text-[#8B6F47] leading-tight mb-8 md:mb-9">
        Cinematic content,<br />crafted with AI.
      </h2>
      <p data-reveal style="--d: 240ms" class="font-sans text-[15px] md:text-[16px] font-light text-[#8C8579] leading-relaxed max-w-[560px] mx-auto">
        Advertising films for brands. Every frame goes through a deliberate process: concept, AI&nbsp;generation, editing, colour, sound.
      </p>
    </div>
  </section>

  <section class="bg-[#E9E3D7] px-6 md:px-10 pt-12 pb-16 md:pt-14 md:pb-20 flex flex-col items-center justify-center">
    <!-- короткая линия-разделитель между Approach и почтой (один фон) -->
    <span class="block w-12 h-px bg-[#8B6F47]/40 mb-12 md:mb-14" aria-hidden="true"></span>
    <!-- почта — один в один как на страницах кейсов (CaseStacked) -->
    <a
      data-reveal
      href="mailto:ina.studio.creative@gmail.com"
      class="mail-shine font-serif font-light text-[26px] md:text-[46px] text-[#8B6F47] underline underline-offset-[10px] md:underline-offset-[11px] decoration-[0.5px] mb-7 md:mb-8 hover:text-[#6E5636] transition-colors duration-700"
    >
      ina.studio.creative@gmail.com
    </a>
    <p data-reveal style="--d: 150ms" class="text-[11px] font-light tracking-[0.2em] pl-[0.2em] text-[#6B6458] uppercase">
      Click to write
    </p>
  </section>
</Layout>
