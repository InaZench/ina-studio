---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";


const cmsEntries = await getCollection("projects");
const cmsProjects = cmsEntries.map((entry) => ({
  title: entry.data.title,
  client: `${entry.data.eyebrow} — ${entry.data.year}`,
  slug: entry.id,
  ratio: "16/10",
  coverImage: entry.data.coverImage,
}));

const projects = cmsProjects;
---

<Layout title="Work — INA">
  <section class="bg-[#EFEAE0] px-6 md:px-10 pt-44 md:pt-56 pb-20 md:pb-28">
    <div class="max-w-[980px] mx-auto text-center">
      <h1 class="font-serif italic font-light text-[36px] md:text-[64px] text-[#0A0A0A] leading-[1.15] mb-9">
        Selected works.
      </h1>
      <p class="font-sans text-[15px] md:text-[16px] font-light text-[#555555] leading-relaxed max-w-[600px] mx-auto" style="text-wrap: balance;">
        Cinematic concept films crafted with AI — for brands in luxury, fashion and product.
      </p>
    </div>
  </section>

  <section class="bg-[#EFEAE0] px-6 md:px-10 pb-20 md:pb-32">
    <div class="max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
        {projects.map((p, i) => (
          <a
            href={`/work/${p.slug}`}
            class={`group block ${i % 2 === 1 ? "md:mt-32" : ""}`}
          >
            <div
              class={`bg-[#1A1A1A] overflow-hidden mb-6 transition-transform duration-700 group-hover:scale-[1.02]`}
              style={`aspect-ratio: ${p.ratio};${p.coverImage ? ` background-image: url('${p.coverImage}'); background-size: cover; background-position: center;` : ""}`}
            ></div>
            <h3 class="font-serif text-[22px] md:text-[26px] font-normal text-[#0A0A0A] leading-tight group-hover:text-[#8B6F47] transition-colors duration-700">
              {p.title}
            </h3>
            <p class="mt-2 text-[11px] font-light tracking-[0.05em] text-[#8C8579] uppercase">
              {p.client}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#0A0A0A] px-6 md:px-10 py-28 md:py-32 min-h-[480px] flex flex-col items-center justify-center">
    <h2 class="font-serif font-light text-[28px] md:text-[42px] text-[#FAFAF7] leading-[1.2] text-center mb-10">
      Let's create something together.
    </h2>
    <a
      href="mailto:ina.studio.creative@gmail.com"
      class="font-serif font-light text-[22px] md:text-[42px] text-[#FAFAF7] underline underline-offset-[8px] decoration-[0.5px] hover:text-[#8B6F47] transition-colors duration-700"
    >
      ina.studio.creative@gmail.com
    </a>
  </section>
</Layout>
