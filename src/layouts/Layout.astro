---
import "../styles/global.css";
// ссылки на файлы шрифтов для preload — грузятся сразу вместе со страницей
import corm300 from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url";
import corm300i from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url";
import inter300 from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";

const {
  title = "INA — Visual stories for brands",
  description = "INA Studio — cinematic AI advertising films for fragrance and technology brands: concept, generation, editing, colour and sound.",
  ogImage = "/og/home.jpg",
} = Astro.props;
// адрес страницы и картинки — полными ссылками (нужно мессенджерам и соцсетям для карточки ссылки)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F8F5EF" />

    <!-- карточка ссылки в мессенджерах и соцсетях (WhatsApp, Telegram, LinkedIn, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INA Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={corm300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={corm300i} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter300} as="font" type="font/woff2" crossorigin />
    <!-- класс js: текст с data-reveal прячется до проявления только при работающем JS -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{title}</title>
  </head>
  <body class="bg-[#EFEAE0] text-[#0A0A0A] font-sans antialiased">
    <!-- TOP NAV -->
    <nav
      id="top-nav"
      class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-6 md:px-10 py-5 md:py-6 bg-[#F8F5EF]/90 backdrop-blur-md border-b border-black/[0.04]"
    >
      <!-- слева: почта (ссылка mailto); на телефоне в две строки -->
      <a
        href="mailto:ina.studio.creative@gmail.com"
        class="text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.16em] md:tracking-[0.3em] text-[#8B6F47] uppercase hover:text-[#6E5636] transition-colors duration-700"
      >
        ina.studio.creative<br class="md:hidden" />@gmail.com
      </a>

      <a
        href="/"
        class="absolute left-1/2 -translate-x-1/2 font-serif text-[20px] md:text-[26px] font-light text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700"
        style="letter-spacing: 0.42em; padding-left: 0.42em;"
      >
        INA
      </a>

      <!-- справа: приглашение; на телефоне в три строки -->
      <!-- -mr = хвостовая разрядка последней буквы: правый край текста ровно по полю, как почта слева -->
      <span class="text-right text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.16em] md:tracking-[0.3em] -mr-[0.16em] md:-mr-[0.3em] text-[#8B6F47] uppercase">
        Let’s create<br class="md:hidden" /> something<br class="md:hidden" /> together
      </span>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer
      class="bg-[#F8F5EF] border-t border-black/[0.08] px-6 md:px-10 py-8 md:py-9"
    >
      <div class="flex justify-end text-right">
        <span class="text-[11px] font-light tracking-[0.15em] -mr-[0.15em] text-[#6B6458]">
          © 2026 INA STUDIO. ALL RIGHTS RESERVED.
        </span>
      </div>
    </footer>

    <script>
      // Проявление текста: элементы с data-reveal плавно поднимаются, когда попадают в кадр.
      // Ждём загрузки шрифтов (не дольше 1.2 с), чтобы заголовок появлялся уже нужным шрифтом.
      const els = document.querySelectorAll("[data-reveal]");
      const show = (el: Element) => el.classList.add("is-in");
      const start = () => {
        if (!("IntersectionObserver" in window)) { els.forEach(show); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.12 });
        // всё, что уже на первом экране, проявляется сразу (по задержкам --d), остальное — при прокрутке
        els.forEach((el) => (el.getBoundingClientRect().top < innerHeight ? show(el) : io.observe(el)));
      };
      // запуск без requestAnimationFrame: он «спит» в фоновой вкладке и у сервисов снимков страниц
      Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]).then(start);
      // страховка: при печати и сохранении в PDF весь текст виден сразу
      addEventListener("beforeprint", () => els.forEach(show));

      // Ролики: чистая заставка и своя кнопка Play; кнопки браузера — после запуска
      document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
        const video = film.querySelector("video")!;
        const btn = film.querySelector("button")!;
        btn.addEventListener("click", () => {
          video.controls = true;
          film.classList.add("is-playing");
          video.play();
        });
        video.addEventListener("play", () => { video.controls = true; film.classList.add("is-playing"); });
      });

      // Живые заставки роликов на страницах проектов — как плитки на главной: кадр медленно приближается
      // (компьютер — при наведении, телефон — когда ролик на экране); во время просмотра — без приближения.
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
        if (still) return;
        const on = () => { if (!film.classList.contains("is-playing")) film.classList.add("is-live"); };
        const off = () => film.classList.remove("is-live");
        if (matchMedia("(hover: hover)").matches) {
          film.addEventListener("mouseenter", on);
          film.addEventListener("mouseleave", off);
        } else if ("IntersectionObserver" in window) {
          new IntersectionObserver((es) => es.forEach((e) => (e.intersectionRatio >= 0.6 ? on() : off())),
            { threshold: [0, 0.6] }).observe(film);
        }
      });

      // Живое превью в Next project: при наведении петля проявляется и играет, после ухода курсора — пауза
      document.querySelectorAll<HTMLVideoElement>("video[data-preview]").forEach((v) => {
        const link = v.closest("a");
        if (!link || !matchMedia("(hover: hover)").matches) return;
        let t: number | undefined;
        const on = () => { clearTimeout(t); v.play().catch(() => {}); };
        const off = () => { t = window.setTimeout(() => v.pause(), 700); };
        link.addEventListener("mouseenter", on);
        link.addEventListener("focus", on);
        link.addEventListener("mouseleave", off);
        link.addEventListener("blur", off);
      });
    </script>
  </body>
</html>
