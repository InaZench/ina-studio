---
import "../styles/global.css";

const { title = "INA — Visual stories for brands", description = "Cinematic visual content crafted with AI for brands." } = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-[#EFEAE0] text-[#0A0A0A] font-sans antialiased">
    <!-- TOP NAV -->
    <nav
      id="top-nav"
      class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-6 md:px-10 py-5 md:py-6 bg-[#F8F5EF]/90 backdrop-blur-md border-b border-black/[0.04]"
    >
      <button
        id="menu-toggle"
        aria-label="Open menu"
        class="flex flex-col gap-[5px] cursor-pointer p-2 -m-2 text-[#0A0A0A]"
      >
        <span class="block w-[22px] h-[1px] bg-current"></span>
        <span class="block w-[22px] h-[1px] bg-current"></span>
        <span class="block w-[22px] h-[1px] bg-current"></span>
      </button>

      <a
        href="/"
        class="absolute left-1/2 -translate-x-1/2 font-serif text-[20px] md:text-[26px] font-light text-[#0A0A0A] hover:text-[#8B6F47] transition-colors duration-700"
        style="letter-spacing: 0.42em; padding-left: 0.42em;"
      >
        INA
      </a>

      <span class="hidden md:inline text-[11px] font-light tracking-[0.3em] text-[#555555]">
        AVAILABLE 2026
      </span>
      <span class="md:hidden text-[9px] font-light tracking-[0.3em] text-[#555555]">
        2026
      </span>
    </nav>

    <!-- MENU OVERLAY -->
    <div
      id="menu-overlay"
      class="fixed inset-0 z-50 bg-[#EFEAE0] hidden flex-col"
    >
      <div class="relative flex items-center justify-between px-6 md:px-10 py-5 md:py-6 min-h-[70px] md:min-h-[87px] bg-[#F8F5EF] border-b border-black/[0.04]">
        <button
          id="menu-close"
          aria-label="Close menu"
          class="text-[28px] font-light leading-none p-2 -m-2 cursor-pointer"
        >
          ×
        </button>
        <span
          class="absolute left-1/2 -translate-x-1/2 font-serif text-[20px] md:text-[26px] font-light"
          style="letter-spacing: 0.42em; padding-left: 0.42em;"
        >
          INA
        </span>
        <span class="hidden md:inline text-[11px] font-light tracking-[0.3em] text-[#555555]">
          AVAILABLE 2026
        </span>
        <span class="md:hidden text-[9px] font-light tracking-[0.3em] text-[#555555]">
          2026
        </span>
      </div>

      <div class="flex-1 flex flex-col justify-center md:justify-start md:pt-32 px-10 md:px-20">
        <nav class="flex flex-col gap-4 md:gap-6">
          <a
            href="/work"
            class="font-serif text-[56px] md:text-[84px] font-light leading-[1.1] text-[#2B2420] hover:text-[#8B6F47] transition-colors duration-700"
          >
            Work
          </a>
          <a
            href="/about"
            class="font-serif text-[56px] md:text-[84px] font-light leading-[1.1] text-[#2B2420] hover:text-[#8B6F47] transition-colors duration-700"
          >
            About
          </a>
          <a
            href="/contact"
            class="font-serif text-[56px] md:text-[84px] font-light leading-[1.1] text-[#2B2420] hover:text-[#8B6F47] transition-colors duration-700"
          >
            Contact
          </a>
        </nav>
      </div>

      <div class="px-10 md:px-20 pt-8 md:pt-10 pb-12 md:pb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6 bg-[#F8F5EF] border-t border-black/[0.08]">
        <div class="inline-flex flex-col items-center self-start md:self-auto">
          <a
            href="mailto:ina.studio.creative@gmail.com"
            class="font-sans text-[14px] underline underline-offset-4 hover:text-[#8B6F47] transition-colors duration-700"
          >
            ina.studio.creative@gmail.com
          </a>
          <p data-copy-hint="Click to copy" class="mt-3 text-[9px] font-light tracking-[0.3em] pl-[0.3em] text-[#8C8579] uppercase">
            Click to copy
          </p>
        </div>
        <p class="font-serif italic font-light text-[17px] md:text-[19px] leading-[1.3] text-[#0A0A0A] md:text-right">
          Let's create<br />something together.
        </p>
      </div>
    </div>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer
      class="bg-[#F8F5EF] border-t border-black/[0.08] px-6 md:px-10 py-8 md:py-9"
    >
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <span class="text-[11px] font-light tracking-[0.2em] text-[#8C8579]">
          INA
        </span>
        <nav class="flex gap-7 text-[10px] font-light tracking-[0.2em] text-[#8C8579] uppercase">
          <a href="/work" class="hover:text-[#8B6F47] transition-colors duration-700">Work</a>
          <a href="/about" class="hover:text-[#8B6F47] transition-colors duration-700">About</a>
          <a href="/contact" class="hover:text-[#8B6F47] transition-colors duration-700">Contact</a>
        </nav>
        <span class="text-[11px] font-light tracking-[0.15em] text-[#8C8579]">
          © 2026 INA STUDIO. ALL RIGHTS RESERVED.
        </span>
      </div>
    </footer>

    <!-- MENU TOGGLE SCRIPT -->
    <script>
      const toggle = document.getElementById("menu-toggle");
      const close = document.getElementById("menu-close");
      const overlay = document.getElementById("menu-overlay");

      toggle?.addEventListener("click", () => {
        overlay?.classList.remove("hidden");
        overlay?.classList.add("flex");
        document.body.style.overflow = "hidden";
      });

      close?.addEventListener("click", () => {
        overlay?.classList.add("hidden");
        overlay?.classList.remove("flex");
        document.body.style.overflow = "";
      });
    </script>
    <!-- COPY EMAIL ON CLICK -->
    <div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[60] px-5 py-3 bg-[#0A0A0A] text-[#FAFAF7] text-[10px] font-light tracking-[0.3em] uppercase pointer-events-none opacity-0 transition-opacity duration-500">Copied</div>
    <script>
      const toast = document.getElementById("copy-toast");
      let toastTimer;
      const copyText = async (text) => {
        try { await navigator.clipboard.writeText(text); return true; }
        catch {
          const ta = document.createElement("textarea");
          ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand("copy"); ta.remove(); return ok;
        }
      };
      document.querySelectorAll('a[href^="mailto:"]').forEach((link) => {
        link.addEventListener("click", async (e) => {
          e.preventDefault();
          const address = link.getAttribute("href").replace("mailto:", "").split("?")[0];
          if (!(await copyText(address))) return;
          const hint = link.parentElement?.querySelector("[data-copy-hint]");
          if (hint) {
            const original = hint.dataset.copyHint;
            hint.textContent = "Copied";
            setTimeout(() => { hint.textContent = original; }, 2000);
          } else if (toast) {
            toast.style.opacity = "1";
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => { toast.style.opacity = "0"; }, 2000);
          }
        });
      });
    </script>
  </body>
</html>
