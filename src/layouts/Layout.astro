---
import "../styles/global.css";

const { title = "INA — Visual stories for brands", description = "Cinematic visual content crafted with AI for brands." } = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-[#EFEAE0] text-[#0A0A0A] font-sans antialiased">
    <!-- TOP NAV -->
    <nav
      id="top-nav"
      class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-6 md:px-10 py-5 md:py-6 bg-[#F8F5EF]/90 backdrop-blur-md border-b border-black/[0.04]"
    >
      <!-- слева: почта (ссылка mailto); на телефоне в две строки -->
      <a
        href="mailto:ina.studio.creative@gmail.com"
        class="text-[8px] md:text-[11px] leading-[1.6] font-light tracking-[0.18em] md:tracking-[0.3em] text-[#8B6F47] uppercase hover:text-[#6E5636] transition-colors duration-700"
      >
        ina.studio.creative<br class="md:hidden" />@gmail.com
      </a>

      <a
        href="/"
        class="absolute left-1/2 -translate-x-1/2 font-serif text-[20px] md:text-[26px] font-light text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700"
        style="letter-spacing: 0.42em; padding-left: 0.42em;"
      >
        INA
      </a>

      <!-- справа: приглашение; на телефоне в три строки -->
      <span class="text-right text-[8px] md:text-[11px] leading-[1.6] font-light tracking-[0.18em] md:tracking-[0.3em] text-[#8B6F47] uppercase">
        Let's create<br class="md:hidden" /> something<br class="md:hidden" /> together
      </span>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer
      class="bg-[#F8F5EF] border-t border-black/[0.08] px-6 md:px-10 py-8 md:py-9"
    >
      <div class="flex justify-end text-right">
        <span class="text-[11px] font-light tracking-[0.15em] text-[#8C8579]">
          © 2026 INA STUDIO. ALL RIGHTS RESERVED.
        </span>
      </div>
    </footer>

  </body>
</html>
