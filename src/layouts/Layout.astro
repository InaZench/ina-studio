---
import "../styles/global.css";
// ссылки на файлы шрифтов для preload — грузятся сразу вместе со страницей
import corm300 from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url";
import corm300i from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url";
import inter300 from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import { getCollection } from "astro:content";

const {
  title = "INA — Visual stories for brands",
  description = "INA Studio — cinematic AI advertising films for fragrance and technology brands: concept, generation, editing, colour and sound.",
  ogImage = "/og/home.jpg",
  projectNav = false,   // 23.11.2026: страницы проектов — шапка «☰ · INA · почта» и меню (главная — без изменений)
} = Astro.props;
// меню: проекты в том же порядке, что на главной
const menuProjects = projectNav ? (await getCollection("projects")).map((e) => ({ slug: e.id, title: e.data.title })) : [];
const currentPath = Astro.url.pathname;
// адрес страницы и картинки — полными ссылками (нужно мессенджерам и соцсетям для карточки ссылки)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F8F5EF" />

    <!-- карточка ссылки в мессенджерах и соцсетях (WhatsApp, Telegram, LinkedIn, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INA Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={corm300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={corm300i} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter300} as="font" type="font/woff2" crossorigin />
    <!-- класс js: текст с data-reveal прячется до проявления только при работающем JS -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{title}</title>
  </head>
  <body class="bg-[#EFEAE0] text-[#0A0A0A] font-sans antialiased">
    <!-- TOP NAV -->
    <!-- 23.11.2026: короткие подписи шапки на телефоне (Email / Enquiries) и логотип INA не переводятся браузером —
         «Электронная почта» в переводе наезжала на логотип, а INA становилось «ИНА» -->
    <nav
      id="top-nav"
      class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-6 md:px-10 py-5 md:py-6 bg-[#F8F5EF]/90 backdrop-blur-md border-b border-black/[0.04]"
    >
      <!-- 22.11.2026: главная — на телефоне «Email · INA · Enquiries», на компьютере почта слева и «Let’s create something together» справа.
           23.11.2026: страницы проектов — слева меню (три полоски), справа почта; логотип по центру -->
      {projectNav ? (
        <button id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu"
          class="group/menu relative -ml-2 p-2 text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700">
          <span class="block w-[22px] md:w-[26px] h-[9px] md:h-[11px] relative">
            <span class="line-shine absolute left-0 top-0 w-full h-px bg-current"></span>
            <span class="line-shine absolute left-0 top-1/2 w-[70%] h-px bg-current transition-[width] duration-700 group-hover/menu:w-full"></span>
            <span class="line-shine absolute left-0 bottom-0 w-full h-px bg-current"></span>
          </span>
        </button>
      ) : (
        <a href="mailto:ina.studio.creative@gmail.com"
          class="group/hl relative text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.2em] md:tracking-[0.22em] text-[#8B6F47] uppercase hover:text-[#6E5636] transition-colors duration-700">
          <span translate="no" class="hdr-shine md:hidden">Email</span><span class="hdr-shine hidden md:inline">ina.studio.creative@gmail.com</span>
          <span aria-hidden="true" class="pointer-events-none absolute left-0 -bottom-[3px] h-px w-full bg-[#8B6F47] origin-left scale-x-0 opacity-0 transition-[scale,opacity] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/hl:scale-x-100 group-hover/hl:opacity-60 group-focus-visible/hl:scale-x-100 group-focus-visible/hl:opacity-60"></span>
        </a>
      )}

      <!-- логотип ведёт на главную: подсказка при наведении (компьютер) — тонкая линия под INA и всплывающее «Home» -->
      <a
        href="/"
        title="Home"
        aria-label="INA — home"
        class="group/logo absolute left-1/2 -translate-x-1/2 font-serif text-[20px] md:text-[26px] font-light text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700"
        style="letter-spacing: 0.42em; padding-left: 0.42em;"
      >
        <span translate="no" class="hdr-shine hdr-d1">INA</span>
        <span aria-hidden="true" class="pointer-events-none absolute left-1/2 -translate-x-1/2 -bottom-[3px] h-px w-[60%] bg-current origin-center scale-x-0 opacity-0 transition-[scale,opacity] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/logo:scale-x-100 group-hover/logo:opacity-60 group-focus-visible/logo:scale-x-100 group-focus-visible/logo:opacity-60"></span>
      </a>

      <!-- -mr = хвостовая разрядка последней буквы: правый край текста ровно по полю -->
      {projectNav ? (
        <a href="mailto:ina.studio.creative@gmail.com" class="group/hl relative text-right text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.2em] md:tracking-[0.22em] -mr-[0.2em] md:-mr-[0.22em] text-[#8B6F47] uppercase hover:text-[#6E5636] transition-colors duration-700">
          <span translate="no" class="hdr-shine hdr-d2 md:hidden">Email</span><span class="hdr-shine hdr-d2 hidden md:inline">ina.studio.creative@gmail.com</span>
          <span aria-hidden="true" class="pointer-events-none absolute left-0 -bottom-[3px] h-px w-[calc(100%-0.22em)] bg-[#8B6F47] origin-left scale-x-0 opacity-0 transition-[scale,opacity] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/hl:scale-x-100 group-hover/hl:opacity-60 group-focus-visible/hl:scale-x-100 group-focus-visible/hl:opacity-60"></span>
        </a>
      ) : (
        <>
          <!-- 23.11.2026: на главной слоган справа — только блик, не ссылка (по просьбе); на телефоне «Enquiries» — письмо, как было -->
          <a href="mailto:ina.studio.creative@gmail.com" class="md:hidden text-right text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.2em] md:tracking-[0.22em] -mr-[0.2em] md:-mr-[0.22em] text-[#8B6F47] uppercase"><span translate="no" class="hdr-shine hdr-d2">Enquiries</span></a>
          <span class="hidden md:inline text-right text-[9px] md:text-[11px] leading-[1.6] font-light tracking-[0.2em] md:tracking-[0.22em] -mr-[0.2em] md:-mr-[0.22em] text-[#8B6F47] uppercase"><span class="hdr-shine hdr-d2">Let’s create something together</span></span>
        </>
      )}
    </nav>

    {projectNav && (
      <!-- 23.11.2026: меню страниц проектов — светлое окно поверх страницы: все проекты (как на главной) и почта -->
      <div id="site-menu" class="menu-panel fixed inset-0 z-50 bg-[#F8F5EF] flex flex-col" aria-hidden="true">
        <div class="flex items-center justify-between px-6 md:px-10 py-5 md:py-6">
          <button id="menu-close" type="button" aria-label="Close menu" class="relative -ml-2 p-2 text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700">
            <span class="block w-[22px] md:w-[26px] h-[22px] md:h-[26px] relative">
              <span class="absolute left-0 top-1/2 w-full h-px bg-current rotate-45"></span>
              <span class="absolute left-0 top-1/2 w-full h-px bg-current -rotate-45"></span>
            </span>
          </button>
        </div>
        <nav class="flex-1 flex flex-col items-center justify-center gap-7 md:gap-9 px-6 pb-20 text-center">
          <a href="/" class="menu-item text-[10px] md:text-[11px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase hover:text-[#8B6F47] transition-colors duration-700">All projects</a>
          {menuProjects.map((p) => (
            <!-- 23.11.2026: названия с бликом (как в шапке), постоянное подчёркивание убрано; при наведении — тонкая линия, как у почты в шапке -->
            <a href={`/${p.slug}/`} class="menu-item group/hl relative font-serif font-light text-[32px] md:text-[48px] leading-[1.1] text-[#8B6F47] hover:text-[#6E5636] transition-colors duration-700">
              <span class="hdr-shine">{p.title}</span>
              <span aria-hidden="true" class="pointer-events-none absolute left-0 -bottom-[2px] h-px w-full bg-[#8B6F47] origin-left scale-x-0 opacity-0 transition-[scale,opacity] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/hl:scale-x-100 group-hover/hl:opacity-60 group-focus-visible/hl:scale-x-100 group-focus-visible/hl:opacity-60"></span>
            </a>
          ))}
          <a href="mailto:ina.studio.creative@gmail.com" class="menu-item mt-4 text-[10px] md:text-[11px] font-light tracking-[0.2em] pl-[0.2em] text-[#6B6458] uppercase hover:text-[#8B6F47] transition-colors duration-700">ina.studio.creative@gmail.com</a>
        </nav>
      </div>
    )}


    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer
      class="bg-[#F8F5EF] border-t border-black/[0.08] px-6 md:px-10 py-8 md:py-9"
    >
      <!-- 22.11.2026: на телефоне надпись по центру (pl = компенсация хвостовой разрядки), на компьютере — справа -->
      <div class="flex justify-center md:justify-end text-center md:text-right">
        <span class="text-[11px] font-light tracking-[0.15em] pl-[0.15em] md:pl-0 md:-mr-[0.15em] text-[#6B6458]">
          © 2026 INA STUDIO. ALL RIGHTS RESERVED.
        </span>
      </div>
    </footer>

    <script>
      // Проявление текста: элементы с data-reveal плавно поднимаются, когда попадают в кадр.
      // Ждём загрузки шрифтов (не дольше 1.2 с), чтобы заголовок появлялся уже нужным шрифтом.
      const els = document.querySelectorAll("[data-reveal]");
      const show = (el: Element) => el.classList.add("is-in");
      const start = () => {
        if (!("IntersectionObserver" in window)) { els.forEach(show); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.12 });
        // всё, что уже на первом экране, проявляется сразу (по задержкам --d), остальное — при прокрутке
        els.forEach((el) => (el.getBoundingClientRect().top < innerHeight ? show(el) : io.observe(el)));
      };
      // запуск без requestAnimationFrame: он «спит» в фоновой вкладке и у сервисов снимков страниц
      Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]).then(start);
      // страховка: при печати и сохранении в PDF весь текст виден сразу
      addEventListener("beforeprint", () => els.forEach(show));

      // Ролики: чистая заставка и своя кнопка Play; кнопки браузера — после запуска
      document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
        const video = film.querySelector("video")!;
        const btn = film.querySelector("button")!;
        btn.addEventListener("click", () => {
          video.controls = true;
          film.classList.add("is-playing");
          video.play();
        });
        video.addEventListener("play", () => { video.controls = true; film.classList.add("is-playing"); });
      });

      // Живые заставки роликов на страницах проектов — как плитки на главной: кадр медленно приближается
      // (компьютер — при наведении, телефон — когда ролик на экране); во время просмотра — без приближения.
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
        if (still) return;
        const on = () => { if (!film.classList.contains("is-playing")) film.classList.add("is-live"); };
        const off = () => film.classList.remove("is-live");
        if (matchMedia("(hover: hover)").matches) {
          film.addEventListener("mouseenter", on);
          film.addEventListener("mouseleave", off);
        } else if ("IntersectionObserver" in window) {
          new IntersectionObserver((es) => es.forEach((e) => (e.intersectionRatio >= 0.6 ? on() : off())),
            { threshold: [0, 0.6] }).observe(film);
        }
      });

      // Живое превью в Next project: при наведении петля проявляется и играет, после ухода курсора — пауза
      document.querySelectorAll<HTMLVideoElement>("video[data-preview]").forEach((v) => {
        const link = v.closest("a");
        if (!link || !matchMedia("(hover: hover)").matches) return;
        let t: number | undefined;
        const on = () => { clearTimeout(t); v.play().catch(() => {}); };
        const off = () => { t = window.setTimeout(() => v.pause(), 700); };
        link.addEventListener("mouseenter", on);
        link.addEventListener("focus", on);
        link.addEventListener("mouseleave", off);
        link.addEventListener("blur", off);
      });
    </script>
      {projectNav && (
      <script is:inline>
        (function () {
          var b = document.getElementById("menu-btn"), m = document.getElementById("site-menu"), c = document.getElementById("menu-close");
          if (!b || !m) return;
          function set(open) { m.classList.toggle("is-open", open); m.setAttribute("aria-hidden", open ? "false" : "true"); b.setAttribute("aria-expanded", open ? "true" : "false"); document.documentElement.style.overflow = open ? "hidden" : ""; }
          b.addEventListener("click", function () { set(true); });
          c.addEventListener("click", function () { set(false); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") set(false); });
        })();
      </script>
    )}
</body>
</html>
