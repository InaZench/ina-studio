---
// Ролик с чистой заставкой и своей тонкой кнопкой Play.
// Кнопки браузера (controls) убираются сразу при разборе страницы и возвращаются после запуска;
// без JS ролик остаётся со стандартными кнопками. Логика клика — в Layout.astro ([data-film]).
const { src, poster, aspect = "16/9", label = "Play film", playY, look, loop } = Astro.props;
// loop — короткая беззвучная петля (2 с): на компьютере оживает при наведении, на телефоне — когда ролик на экране;
// после запуска фильма скрывается. Грузится только при первом показе (preload="none").
// playY — кнопка не по центру, а на этой высоте (по центру по горизонтали), меньше на телефоне:
// для заставок, где в центре продукт (Goutte d’Aigue: кнопка на прозрачном дне флакона, под жидкостью).
// look="clear" — почти прозрачная кнопка (тонкий белый контур и значок, без заливки), одинаковая на всех роликах проекта;
// на компьютере 44 px, на телефоне 44 px (или 26 px, если кнопка сдвинута на дно флакона — там мало места)
const clear = look === "clear";
const size = playY ? "w-[26px] h-[26px] md:w-[44px] md:h-[44px]"
  : clear ? "w-[44px] h-[44px] md:w-[44px] md:h-[44px]" : "w-[44px] h-[44px] md:w-[56px] md:h-[56px]";
const icon = playY ? "w-[7px] h-[8px] md:w-[10px] md:h-[12px] ml-[1px] md:ml-[2px]"
  : clear ? "w-[10px] h-[12px] ml-[2px]" : "w-[10px] h-[12px] md:w-[13px] md:h-[15px] ml-[2px]";
const pos = playY ? `position:absolute;left:50%;top:${playY};translate:-50% -50%;` : "";
const tone = clear
  ? "border-white/80 bg-white/[0.04] backdrop-blur-[2px] shadow-[0_0_8px_rgba(20,50,56,0.14)] group-hover:bg-white/10 group-hover:border-white"
  : "border-white/80 bg-black/25 backdrop-blur-[3px] shadow-[0_0_28px_rgba(0,0,0,0.28)] group-hover:bg-black/15 group-hover:border-white";
const stroke = "#fff";
---
<div class="film relative" data-film>
  <video
    class="block w-full"
    style={`aspect-ratio: ${aspect}; object-fit: contain; background: #0A0A0A;`}
    src={src}
    poster={poster}
    controls
    playsinline
    preload="metadata"
  />
  <script is:inline>document.currentScript.previousElementSibling.removeAttribute("controls");</script>
  {loop && (
    <video
      class="film-loop"
      data-film-loop
      src={loop}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      style={`aspect-ratio: ${aspect}; object-fit: contain;`}
    />
  )}
  <button
    type="button"
    aria-label={label}
    class="film-play group absolute inset-0 flex items-center justify-center cursor-pointer"
  >
    <span style={pos} class:list={["flex items-center justify-center rounded-full", size, tone, "border transition-[background-color,border-color,scale] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:scale-[1.04]"]}>
      <svg class={icon} viewBox="0 0 17 20" fill="none" aria-hidden="true">
        <path d="M1 1.2 16 10 1 18.8Z" stroke={stroke} stroke-width="1.1" stroke-linejoin="round" />
      </svg>
    </span>
  </button>
</div>
