---
// Раскладка кейса (включается в проекте полем pageLayout: stacked) — «разворот»:
// слева ролик 4:5, под ним строка про ИИ (в одну строку) и Brief — прижаты к низу, низ Brief на уровне подписи
// вертикального ролика; справа окно с фразой (по левому краю, оптический центр, интерлиньяж 1.55),
// под ним вертикальный ролик,
// его верх на уровне 60% высоты первого (отступ 105% ширины своей колонки при колонках 7:5), между колонками 128 px.
// На телефоне: ролик → вертикальный ролик → текст. Фон #EFEAE0, почта — #E9E3D7; шапка и подвал светлее.
// Ролики показываются целиком (object-fit: contain); во весь экран — на чёрном (правило в global.css).
import { getCollection } from "astro:content";
import Film from "./Film.astro";
const { project } = Astro.props;
// следующий проект — по полю nextProject (id файла проекта); название и обложка берутся из его карточки
const next = project.nextProject ? (await getCollection("projects")).find((e) => e.id === project.nextProject) : null;
// heroAspect («16/9», «4/3»): горизонтальный ролик -> широкая раскладка; без поля — ролик 4:5 «разворотом»
const [aw, ah] = (project.heroAspect || "4/5").split("/").map(Number);
const wide = aw > ah;
// на телефоне ноты аромата (абзацы после первого) — мельче, каждая строка без переносов
const [phrase, ...rest] = (project.objective || "").split(/\n\s*\n/);
const notes = rest.join("\n\n");
// строки фразы и нот — отдельными элементами: переводчик браузера иначе сливает их в одну строку
const phraseLines = phrase.split("\n").map((l) => l.trim()).filter(Boolean);
const notesLines = notes.split("\n").map((l) => l.trim()).filter(Boolean);
---
<h1 class="sr-only">{project.title}</h1>

{wide ? (
<section class="bg-[#EFEAE0] px-6 md:px-10 pt-[120px] md:pt-[184px] pb-24 md:pb-32">
  <div class="max-w-[1140px] mx-auto">
    {project.heroVideo && (
      <div class="mx-auto" style={`max-width: min(100%, calc((100vh - 240px) * ${aw} / ${ah}));`}>
        <Film src={project.heroVideo} poster={project.heroPoster} aspect={`${aw}/${ah}`} playY={project.heroPlayY} playSmall={!!project.heroPlayY} look={project.playLook} />
        {project.heroLabel && (
          <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase text-center mt-6">{project.heroLabel}</p>
        )}
      </div>
    )}
    {project.verticalVideo ? (
      <div class="grid grid-cols-1 md:grid-cols-[7fr_5fr] gap-y-14 md:gap-y-0 md:gap-x-40 mt-14 md:mt-32">
        <!-- как на странице телефона: строка про ИИ и Brief сдвинуты на 52 px к краю, низ Brief — на 58 px ниже подписи вертикального ролика -->
        <div class="flex flex-col md:justify-between md:col-start-1 md:row-start-1">
          <!-- фраза с нотами: по центру между краем страницы и вертикальным роликом (равные поля слева и справа),
               по высоте — в оптическом центре свободного места над строкой про ИИ (~42 %, как фраза у телефона).
               Фраза — по смыслу на две строки (перенос в тексте проекта), ноты — каждая строка отдельным элементом. -->
          <div class="hidden md:flex flex-col flex-1">
            <div style="flex: 0.553 1 0"></div>
            <!-- сдвиг = середина между краем экрана и вертикальным роликом минус центр колонки: 80px − (поле контейнера)/2 -->
            <div data-reveal class="max-w-[540px] mx-auto text-center font-serif font-light text-[30px] leading-[1.55] text-[#8B6F47]" style="translate: clamp(-50px, calc(80px - max(40px, (100vw - 1140px) / 2) / 2), 60px) 0;">
              <p style="text-wrap: balance;">{phraseLines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
              {notesLines.length > 0 && (
                <div class="mt-[1.55em]">{notesLines.map((l) => (<p style="text-wrap: balance;">{l}</p>))}</div>
              )}
            </div>
            <div style="flex: 0.447 1 0"></div>
          </div>
          <div class="flex flex-col md:block mt-2 md:mt-24 md:translate-y-[44px] md:-translate-x-[min(52px,max(12px,calc((100vw-1140px)/2-28px)))]">
      {project.heroNote && (
        <p data-reveal class="text-[length:min(9px,calc((100vw-48px)/39.6))] leading-[1.9] font-light tracking-[0.03em] [text-wrap:balance] text-center md:text-[9px] md:tracking-[0.12em] lg:text-[10px] lg:tracking-[0.22em] text-[#6B6458] uppercase order-2 mb-8 md:mb-[56px] md:w-full md:max-w-[520px]">{project.heroNote}</p>
      )}
      <div class="md:hidden order-1 text-center font-serif font-light text-[#8B6F47] mb-20">
        <p data-reveal class="text-[24px] leading-[1.45]" style="text-wrap: balance;">{phraseLines.join(" ")}</p>
        {notesLines.length > 0 && (<div data-reveal style="--d: 150ms" class="mt-6 text-[length:min(19px,calc((100vw-48px)/18))] leading-[1.6] [text-wrap:balance]">{notesLines.map((l) => (<p>{l}</p>))}</div>)}
      </div>
      <div data-reveal style="--d: 120ms" class="order-3 border-t border-black/[0.08] md:w-full md:max-w-[520px]">
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Client</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.client}</span>
          </div>
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Format</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.format}</span>
          </div>
          {project.tools && (
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Tools</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.tools}</span>
          </div>
          )}
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Delivery</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.delivery}</span>
          </div>
      </div>
          </div>
        </div>
        <div class="order-first md:order-none md:col-start-2 md:row-start-1">
          <Film src={project.verticalVideo} poster={project.verticalPoster} aspect="9/16" playY={project.verticalPlayY} look={project.playLook} />
          <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase text-center mt-6">{project.verticalEyebrow || "Vertical version"}</p>
        </div>
      </div>
    ) : (
      <div class="flex flex-col items-center mt-14 md:mt-28">
        <div class="hidden md:block mb-24"><p data-reveal class="hidden md:block max-w-[540px] mx-auto text-center font-serif font-light text-[30px] leading-[1.55] text-[#8B6F47] whitespace-pre-line" style="text-wrap: balance;">{project.objective}</p></div>
        <div class="flex flex-col w-full md:max-w-[520px]">
      {project.heroNote && (
        <p data-reveal class="text-[length:min(9px,calc((100vw-48px)/39.6))] leading-[1.9] font-light tracking-[0.03em] [text-wrap:balance] text-center md:text-[9px] md:tracking-[0.12em] lg:text-[10px] lg:tracking-[0.22em] text-[#6B6458] uppercase order-2 mb-8 md:mb-[56px] md:text-center">{project.heroNote}</p>
      )}
      <div class="md:hidden order-1 text-center font-serif font-light text-[#8B6F47] mb-20">
        <p data-reveal class="text-[24px] leading-[1.45] whitespace-pre-line" style="text-wrap: balance;">{phrase}</p>
        {notes && (<p data-reveal style="--d: 150ms" class="mt-6 text-[length:min(19px,calc((100vw-48px)/18))] leading-[1.6] whitespace-pre-line [text-wrap:balance]">{notes}</p>)}
      </div>
      <div data-reveal style="--d: 120ms" class="order-3 border-t border-black/[0.08] md:max-w-[520px]">
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Client</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.client}</span>
          </div>
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Format</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.format}</span>
          </div>
          {project.tools && (
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Tools</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.tools}</span>
          </div>
          )}
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Delivery</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.delivery}</span>
          </div>
      </div>
        </div>
      </div>
    )}
  </div>
</section>
) : (
<section class="bg-[#EFEAE0] px-6 md:px-10 pt-[120px] md:pt-[184px] pb-24 md:pb-32">
  <div class="max-w-[1140px] mx-auto grid grid-cols-1 md:grid-cols-[7fr_5fr] gap-y-14 md:gap-y-0 md:gap-x-40">
    {project.heroVideo && (
      <div class="md:col-start-1 md:row-start-1">
        <Film src={project.heroVideo} poster={project.heroPoster} aspect="4/5" />
        {project.heroLabel && (
          <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase text-center mt-6">{project.heroLabel}</p>
        )}
      </div>
    )}
    {project.verticalVideo && (
      <div class="relative md:col-start-2 md:row-start-1 md:row-span-2 md:pt-[105%]">
        <!-- окно над вертикальным роликом (высота = 105% ширины колонки); фраза по центру окна по горизонтали, в оптическом центре по вертикали -->
        <div class="hidden md:flex absolute top-0 left-0 right-0 items-center justify-center pb-[24%]" style="aspect-ratio: 1 / 1.05;">
          <!-- сдвиг: фраза по центру между горизонтальным роликом и правым краем экрана (равные поля): (поле контейнера)/2 − 80px -->
          <!-- строки фразы — отдельными элементами (переводчик браузера иначе сливает их); 34 px — чтобы фраза не терялась в пустом окне -->
          <div data-reveal class="max-w-[400px] text-center font-serif font-light text-[34px] leading-[1.55] text-[#8B6F47]" style="translate: clamp(-50px, calc(max(40px, (100vw - 1140px) / 2) / 2 - 80px), 50px) 0;">{phraseLines.map((l) => (<p style="text-wrap: balance;">{l}</p>))}</div>
        </div>
        <Film src={project.verticalVideo} poster={project.verticalPoster} aspect="9/16" playY={project.verticalPlayY} look={project.playLook} />
        <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#6B6458] uppercase text-center mt-6">{project.verticalEyebrow || "Also in this campaign"}</p>
        {project.verticalCaption && (
          <p class="text-[10px] font-light tracking-[0.25em] text-[#6B6458] uppercase text-center mt-3">{project.verticalCaption}</p>
        )}
      </div>
    )}
    <div class="flex flex-col md:block md:col-start-1 md:row-start-2 mt-2 md:mt-24 md:self-end md:translate-y-[44px] md:-translate-x-[min(52px,max(12px,calc((100vw-1140px)/2-28px)))]">
      {project.heroNote && (
        <p data-reveal class="text-[length:min(9px,calc((100vw-48px)/39.6))] leading-[1.9] font-light tracking-[0.03em] [text-wrap:balance] text-center md:text-[9px] md:tracking-[0.12em] lg:text-[10px] lg:tracking-[0.22em] text-[#6B6458] uppercase order-2 mb-8 md:mb-[56px] md:max-w-[520px]">{project.heroNote}</p>
      )}
      <div class="md:hidden order-1 text-center font-serif font-light text-[#8B6F47] mb-20">
        <div data-reveal class="text-[24px] leading-[1.45]">{phraseLines.map((l) => (<p style="text-wrap: balance;">{l}</p>))}</div>
        {notes && (<p data-reveal style="--d: 150ms" class="mt-6 text-[length:min(19px,calc((100vw-48px)/18))] leading-[1.6] whitespace-pre-line [text-wrap:balance]">{notes}</p>)}
      </div>
      <div data-reveal style="--d: 120ms" class="order-3 border-t border-black/[0.08] md:max-w-[520px]">
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Client</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.client}</span>
          </div>
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Format</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.format}</span>
          </div>
          {project.tools && (
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Tools</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.tools}</span>
          </div>
          )}
          <div class="border-b border-black/[0.08] py-4 flex justify-between items-baseline gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#6B6458] uppercase">Delivery</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.delivery}</span>
          </div>
      </div>
    </div>
  </div>
</section>
)}

{next && (
<section class="bg-[#EFEAE0] px-6 md:px-10 pb-16 md:pb-20">
  <a href={`/${next.id}/`} class="group max-w-[1140px] mx-auto border-t border-black/[0.08] pt-12 md:pt-16 flex items-center gap-10 md:gap-0">
    <div>
      <p data-reveal class="flex items-center gap-4 md:gap-5 font-serif font-light text-[30px] md:text-[44px] leading-[1.2] text-[#8B6F47] group-hover:text-[#6E5636] transition-colors duration-700">
        <span>{next.data.title}</span>
        <svg class="w-[0.85em] h-[0.5em] translate-y-[0.06em] shrink-0 transition-[translate] duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:translate-x-[6px]" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 10h32M24 2l8 8-8 8"/></svg>
      </p>
    </div>
    {next.data.coverImage && (
      <!-- обложка — всегда в 106 px за стрелкой (одинаково на всех страницах, образец — Goutte d'Aigue → From Morning to Night);
           при наведении поверх неё плавно проявляется живое превью (петля без звука, play/pause — в Layout.astro) -->
      <div class="hidden md:block relative overflow-hidden md:ml-[106px] w-[220px] shrink-0 bg-[#1A1A1A]" style={`aspect-ratio: 16/10; background-image: url('${next.data.coverImage}'); background-size: cover; background-position: center;`}>
        {next.data.previewVideo && (
          <video
            data-preview
            class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:opacity-100 group-focus-visible:opacity-100"
            src={next.data.previewVideo}
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
      </div>
    )}
  </a>
</section>
)}

<section class="bg-[#E9E3D7] px-6 md:px-10 py-28 md:py-32 min-h-[480px] flex flex-col items-center justify-center">
  <a
    data-reveal
    href="mailto:ina.studio.creative@gmail.com"
    class="font-serif font-light text-[26px] md:text-[46px] text-[#8B6F47] underline underline-offset-[10px] md:underline-offset-[11px] decoration-[0.5px] -mt-4 md:mt-2 mb-7 md:mb-8 hover:text-[#6E5636] transition-colors duration-700"
  >
    ina.studio.creative@gmail.com
  </a>
  <p data-reveal style="--d: 150ms" class="text-[11px] font-light tracking-[0.2em] pl-[0.2em] text-[#6B6458] uppercase">
    Click to write
  </p>
</section>
