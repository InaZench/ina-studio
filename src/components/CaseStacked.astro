---
// Раскладка кейса (включается в проекте полем pageLayout: stacked) — «разворот»:
// слева ролик 4:5, под ним строка про ИИ (в одну строку) и Brief — прижаты к низу, низ Brief на уровне подписи
// вертикального ролика; справа окно с фразой (по левому краю, оптический центр, интерлиньяж 1.55),
// под ним вертикальный ролик,
// его верх на уровне 60% высоты первого (отступ 105% ширины своей колонки при колонках 7:5), между колонками 128 px.
// На телефоне: ролик → вертикальный ролик → текст. Фон #EFEAE0, почта — #E9E3D7; шапка и подвал светлее.
// Ролики показываются целиком (object-fit: contain); во весь экран — на чёрном (правило в global.css).
const { project } = Astro.props;
---
<h1 class="sr-only">{project.title}</h1>

<section class="bg-[#EFEAE0] px-6 md:px-10 pt-[120px] md:pt-[184px] pb-24 md:pb-32">
  <div class="max-w-[1140px] mx-auto grid grid-cols-1 md:grid-cols-[7fr_5fr] gap-y-14 md:gap-y-0 md:gap-x-32">
    {project.heroVideo && (
      <div class="md:col-start-1 md:row-start-1">
        <video
          class="block w-full"
          style="aspect-ratio: 4/5; object-fit: contain; background: #0A0A0A;"
          src={project.heroVideo}
          controls
          playsinline
          preload="metadata"
        />
        {project.heroLabel && (
          <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#8C8579] uppercase mt-6">{project.heroLabel}</p>
        )}
      </div>
    )}
    {project.verticalVideo && (
      <div class="relative md:col-start-2 md:row-start-1 md:row-span-2 md:pt-[105%]">
        <!-- окно над вертикальным роликом (высота = 105% ширины колонки); фраза по центру окна по горизонтали, в оптическом центре по вертикали -->
        <div class="hidden md:flex absolute top-0 left-0 right-0 items-center justify-center pb-[8%]" style="aspect-ratio: 1 / 1.05;">
          <p class="max-w-[400px] text-center font-serif font-light text-[30px] leading-[1.55] text-[#0A0A0A] whitespace-pre-line" style="text-wrap: balance;">{project.objective}</p>
        </div>
        <video
          class="block w-full"
          style="aspect-ratio: 9/16; object-fit: contain; background: #0A0A0A;"
          src={project.verticalVideo}
          controls
          playsinline
          preload="metadata"
        />
        <p class="text-[10px] leading-[15px] font-light tracking-[0.3em] pl-[0.3em] text-[#8C8579] uppercase mt-6">{project.verticalEyebrow || "Also in this campaign"}</p>
        {project.verticalCaption && (
          <p class="text-[10px] font-light tracking-[0.25em] text-[#8C8579] uppercase mt-3">{project.verticalCaption}</p>
        )}
      </div>
    )}
    <div class="md:col-start-1 md:row-start-2 mt-6 md:mt-24 md:self-end">
      {project.heroNote && (
        <p class="text-[10px] leading-[1.9] font-light tracking-[0.3em] md:text-[9px] md:tracking-[0.12em] lg:text-[10px] lg:tracking-[0.22em] text-[#8C8579] uppercase mb-8 md:mb-[88px] md:whitespace-nowrap md:max-w-[520px] md:text-center">{project.heroNote}</p>
      )}
      <p class="md:hidden font-serif font-light text-[24px] leading-[1.35] text-[#0A0A0A] whitespace-pre-line mb-12" style="text-wrap: balance;">{project.objective}</p>
      <div class="border-t border-black/[0.08] md:max-w-[520px]">
          <div class="border-b border-black/[0.08] py-4 flex justify-between gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#8C8579] uppercase">Client</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.client}</span>
          </div>
          <div class="border-b border-black/[0.08] py-4 flex justify-between gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#8C8579] uppercase">Format</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.format}</span>
          </div>
          <div class="border-b border-black/[0.08] py-4 flex justify-between gap-4">
            <span class="text-[10px] font-light tracking-[0.2em] text-[#8C8579] uppercase">Delivery</span>
            <span class="font-serif text-[15px] md:text-[16px] text-[#0A0A0A] text-right">{project.delivery}</span>
          </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-[#E9E3D7] px-6 md:px-10 py-28 md:py-32 min-h-[480px] flex flex-col items-center justify-center">
  <h2 class="font-serif font-light text-[28px] md:text-[42px] text-[#0A0A0A] leading-[1.2] text-center mb-10">
    Let's create something together.
  </h2>
  <a
    href="mailto:ina.studio.creative@gmail.com"
    class="font-serif font-light text-[22px] md:text-[42px] text-[#0A0A0A] underline underline-offset-[8px] decoration-[0.5px] mb-6 hover:text-[#8B6F47] transition-colors duration-700"
  >
    ina.studio.creative@gmail.com
  </a>
  <p class="text-[11px] font-light tracking-[0.2em] pl-[0.2em] text-[#8C8579] uppercase">
    Click to write
  </p>
</section>
